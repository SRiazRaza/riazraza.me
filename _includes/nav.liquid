{% if page.url == '/' %}{% assign homepage = true %}{% endif %}
<link href="https://fonts.cdnfonts.com/css/pacifico" rel="stylesheet">

<div class="{% unless homepage %}border-bottom{% endunless %}">
  <div class="container-lg px-3">
    <div class="py-4 d-flex flex-justify-between">
      <h1 class="h4 lh-default" style="min-height:48px;display:flex;align-items:center;">
        {% unless homepage %}
        <a href="/" class=" no-underline  text-brand-blue-dark d-flex flex-items-center">
          <img class="mr-2 mt-n2" src="/assets/img/probot-head.png" width="36" height="36" alt="">
          <span class="title-head">Riaz Raza</span>
        </a>
        {% endunless %}
      </h1>
      <div>
      <div class="burger-menu" id="burgerMenu">
        <div class="burger-bar"></div>
        <div class="burger-bar"></div>
        <div class="burger-bar"></div>
      </div>
      <nav class="NavbarNav text-bold text-right" id="navbarNav">
        <a class="text-inherit px-2 d-inline-block" href="/" data-i18n="nav.home">Home</a>
        <a class="text-inherit px-2 d-inline-block" href="/projects/" data-i18n="nav.projects">Projects</a>
        <a class="text-inherit px-2 d-inline-block" href="/blog/" data-i18n="nav.blog">Blog</a>
        <a class="text-inherit px-2 d-inline-block" href="/products/" data-i18n="nav.products">Products</a>
        <a class="text-inherit px-2 d-inline-block" href="/about/" data-i18n="nav.about">About</a>
        <a class="text-inherit px-2 d-inline-block" href="/contact/" data-i18n="nav.contact">Contact</a>
        <div class="lang-dropdown-wrap">
          <button class="lang-toggle-btn" id="lang-toggle-btn" aria-haspopup="listbox" aria-expanded="false" title="Switch language">🌐 <span id="lang-label">EN</span> ▾</button>
          <ul class="lang-dropdown" id="lang-dropdown" role="listbox" aria-label="Select language">
            <li role="option" data-lang="EN" class="lang-option active">🇬🇧 English</li>
            <li role="option" data-lang="IT" class="lang-option">🇮🇹 Italiano</li>
            <li role="option" data-lang="UR" class="lang-option">🇵🇰 اردو</li>
          </ul>
        </div>
        <button id="manga-toggle" class="manga-toggle-btn" aria-pressed="false" title="Toggle Manga/Games Mode">🎌 <span class="btn-icon" data-i18n="nav.manga">Manga</span></button>
      </nav>
      </div>
    </div>
  </div>
</div>
<script>
  const burgerMenu = document.getElementById('burgerMenu');
  const navbarNav = document.getElementById('navbarNav');

  burgerMenu.addEventListener('click', () => {
    navbarNav.classList.toggle('open');
  });
</script>
