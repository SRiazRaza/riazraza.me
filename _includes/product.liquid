<div class="card m-2 shadow-sm border-0 rounded-lg product-card" style="width: 20rem; transition: transform 0.2s, box-shadow 0.2s;">
  <img src="{{ product.image[0] }}" class="card-img-top rounded-top" alt="{{ product.title }}" style="height: 180px; object-fit: cover;" loading="lazy">
  <div class="card-body d-flex flex-column justify-content-between">
    <h5 class="card-title font-weight-bold mb-2" style="font-size: 1.25rem;">{{ product.title }}</h5>
    <p class="card-text text-secondary mb-2" style="font-size: 1rem;">{{ product.description }}</p>
    {% if product.templateContent %}
      <div class="mb-2" style="font-size: 0.95em; color: #555;">
        {{ product.templateContent | striptags | truncate: 100 }}
      </div>
    {% endif %}
  </div>
</div>

<style>
.product-card:hover {
  transform: translateY(-6px) scale(1.03);
  box-shadow: 0 8px 24px rgba(0,0,0,0.15), 0 1.5px 4px rgba(0,0,0,0.08);
  border-color: #1976d2;
}
</style> 