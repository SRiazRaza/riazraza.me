<div class="col-12 col-md-6 col-lg-4 mb-3 mt-3 d-flex flex-column pt-4">
  <!-- Card container with a border, taking you to the project page -->
  <a
    href="/projects/{{ project.slug }}/"
    class="project-card d-flex flex-column color-bg-primary rounded-1 box-shadow border text-inherit no-underline flex-1"
    style="border: 1px solid #ddd; padding: 10px;"
  >
    <!-- project image container -->
    <div class="project-image-container" style="width: 100%; height: 180px; overflow: hidden; border-radius: 4px; background: #f6f8fa;">
      <img src="{{ project.screenshots[0] }}" alt="Screenshot of {{ project.title }} project" style="width: 100%; height: 100%; object-fit: cover; object-position: top center;" loading="lazy">
    </div>
  </a>

  <!-- project title with no margin and bottom border -->
  <h3 class="h4" >
    <a href="/projects/{{ project.slug }}/" class="text-inherit no-underline" style="color: black; font-family: 'Garamond', serif; font-weight: bold; font-size: 13pt;">{{ project.title }}</a>
  </h3>

  <!-- Author and GitHub section without margin between the title and this div -->
  <div class="color-text-tertiary pr-2 pl-1 color-bg-tertiary-light" >
    <div class="d-flex flex-row align-items-center">
      <div class="col-3">
        <a href="https://github.com/{{ project.repository }}" target="_blank" aria-label="{{ project.repository }}" class="tooltipped tooltipped-s">
          {% octicon "mark-github" height=24 class="v-align-middle" %}
        </a>
      </div>

      <!-- Author section with avatar and link -->
      <div class="col-9 text-right">
        {% for author in project.authors %}
        <a href="https://github.com/{{ author }}" target="_blank" aria-label="Made by {{ author }}" class="tooltipped tooltipped-s">
          <img
            class="avatar"
            alt="Made by {{ author }}"
            aria-label="Made by {{ author }}"
            height="24"
            src="https://github.com/{{ author }}.png"
            style="border-radius: 50%;"
          />
        </a>
        {% endfor %}
      </div>

    </div>
  </div>
</div>